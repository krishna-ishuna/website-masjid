<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        .hero-section {
            background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url('https://images.unsplash.com/photo-1584551246679-0daf3d275d0f?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80');
            background-size: cover;
            background-position: center;
            color: white;
            padding: 120px 0;
        }

        .card-hover:hover {
            transform: translateY(-5px);
            transition: all 0.3s ease;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
        }
    </style>
</head>

<body>

    <% include('../partials/navbar') %>

        <!-- Hero Section -->
        <section class="hero-section text-center">
            <div class="container">
                <h1 class="display-4 fw-bold mb-3">Masjid Al-Ikhlas</h1>
                <p class="lead mb-4">Memakmurkan Masjid, Membangun Umat</p>
                <a href="/keuangan" class="btn btn-success btn-lg me-2">
                    <i class="bi bi-wallet2"></i> Donasi & Infaq
                </a>
                <a href="/pengumuman" class="btn btn-outline-light btn-lg">
                    <i class="bi bi-calendar-event"></i> Jadwal Kegiatan
                </a>
            </div>
        </section>

        <!-- Info Singkat & Saldo -->
        <section class="py-5 bg-light">
            <div class="container">
                <div class="row g-4">
                    <div class="col-md-4">
                        <div class="card h-100 text-center border-0 shadow-sm card-hover">
                            <div class="card-body">
                                <i class="bi bi-clock-history text-success" style="font-size: 3rem;"></i>
                                <h4 class="mt-3">Jadwal Sholat</h4>
                                <p class="text-muted">Lihat jadwal sholat harian dan waktu imsakiyah.</p>
                                <a href="/jadwal" class="btn btn-outline-success">Lihat Jadwal</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card h-100 text-center border-0 shadow-sm card-hover">
                            <div class="card-body">
                                <i class="bi bi-book text-success" style="font-size: 3rem;"></i>
                                <h4 class="mt-3">Kajian Rutin</h4>
                                <p class="text-muted">Ikuti kajian subuh, maghrib, dan akhir pekan.</p>
                                <a href="/pengumuman" class="btn btn-outline-success">Lihat Kajian</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card h-100 text-center border-0 shadow-sm card-hover bg-success text-white">
                            <div class="card-body">
                                <i class="bi bi-piggy-bank" style="font-size: 3rem;"></i>
                                <h4 class="mt-3">Saldo Kas Masjid</h4>
                                <h2 class="fw-bold">Rp <%= saldo.toLocaleString('id-ID') %>
                                </h2>
                                <a href="/keuangan" class="btn btn-light text-success mt-2">Lihat Laporan Lengkap</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Widget Jadwal Sholat -->
        <section class="py-5 bg-success text-white">
            <div class="container">
                <div class="text-center mb-4">
                    <h2 class="fw-bold"><i class="bi bi-clock-history"></i> Jadwal Sholat Hari Ini</h2>
                    <p class="mb-0">Wilayah Jakarta dan sekitarnya</p>
                </div>
                <div class="row g-3 justify-content-center" id="widgetJadwal">
                    <div class="col-12 text-center">
                        <div class="spinner-border" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2">Memuat jadwal...</p>
                    </div>
                </div>
            </div>
        </section>

        <script>
            // Widget mini jadwal sholat di beranda
            (async function () {
                try {
                    const today = new Date();
                    const tanggal = `${String(today.getDate()).padStart(2, '0')}-${String(today.getMonth() + 1).padStart(2, '0')}-${today.getFullYear()}`;
                    const response = await fetch(`https://api.aladhan.com/v1/timings/${tanggal}?latitude=-6.2088&longitude=106.8456&method=20`);
                    const data = await response.json();

                    if (data.code === 200) {
                        const timings = data.data.timings;
                        const waktuUtama = [
                            { key: 'Fajr', nama: 'Subuh' },
                            { key: 'Dhuhr', nama: 'Dzuhur' },
                            { key: 'Asr', nama: 'Ashar' },
                            { key: 'Maghrib', nama: 'Maghrib' },
                            { key: 'Isha', nama: 'Isya' }
                        ];

                        let html = '';
                        waktuUtama.forEach(w => {
                            html += `
            <div class="col-6 col-md">
              <div class="text-center p-3 bg-white bg-opacity-10 rounded">
                <small class="d-block opacity-75">${w.nama}</small>
                <strong style="font-size: 1.5rem;">${timings[w.key]}</strong>
              </div>
            </div>
          `;
                        });
                        document.getElementById('widgetJadwal').innerHTML = html;
                    }
                } catch (error) {
                    console.error('Widget error:', error);
                    document.getElementById('widgetJadwal').innerHTML =
                        '<div class="col-12 text-center">Gagal memuat jadwal sholat</div>';
                }
            })();
        </script>

        <!-- Pengumuman Terbaru -->
        <section class="py-5">
            <div class="container">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="fw-bold">📢 Pengumuman Terbaru</h2>
                    <a href="/pengumuman" class="btn btn-outline-success">Lihat Semua</a>
                </div>

                <% if (pengumumanTerbaru.length===0) { %>
                    <div class="alert alert-info text-center">Belum ada pengumuman terbaru.</div>
                    <% } else { %>
                        <div class="row g-4">
                            <!-- Ganti bagian pengumumanTerbaru.forEach dengan ini -->
                            <% pengumumanTerbaru.forEach(p=> { %>
                                <div class="col-md-4">
                                    <div class="card h-100 shadow-sm card-hover">
                                        <% if (p.gambar) { %>
                                            <img src="/uploads/<%= p.gambar %>" class="card-img-top"
                                                alt="<%= p.judul %>" style="height: 200px; object-fit: cover;">
                                            <% } %>
                                                <div class="card-body">
                                                    <span class="badge bg-success mb-2">
                                                        <%= p.kategori %>
                                                    </span>
                                                    <h5 class="card-title">
                                                        <%= p.judul %>
                                                    </h5>
                                                    <p class="card-text text-muted">
                                                        <%= p.isi.substring(0, 100) %>...
                                                    </p>
                                                </div>
                                                <div class="card-footer bg-white border-0">
                                                    <small class="text-muted">
                                                        <i class="bi bi-calendar3"></i>
                                                        <%= new Date(p.tanggal).toLocaleDateString('id-ID', {
                                                            day: 'numeric' , month: 'long' , year: 'numeric' }) %>
                                                    </small>
                                                </div>
                                    </div>
                                </div>
                                <% }) %>
                        </div>
                        <% } %>
            </div>
        </section>

        <!-- Galeri Terbaru -->
        <section class="py-5">
            <div class="container">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="fw-bold">🖼️ Galeri Kegiatan</h2>
                    <a href="/galeri" class="btn btn-outline-success">Lihat Semua</a>
                </div>
                <div class="row g-3" id="galeriBeranda">
                    <div class="col-12 text-center text-muted">
                        <div class="spinner-border spinner-border-sm" role="status"></div> Memuat galeri...
                    </div>
                </div>
            </div>
        </section>

        <script>
            // Ambil 4 foto terbaru untuk beranda
            (async function () {
                try {
                    const response = await fetch('/api/galeri-terbaru');
                    const galeri = await response.json();
                    const container = document.getElementById('galeriBeranda');

                    if (galeri.length === 0) {
                        container.innerHTML = '<div class="col-12 text-center text-muted">Belum ada foto galeri.</div>';
                        return;
                    }

                    let html = '';
                    galeri.forEach(g => {
                        html += `
          <div class="col-6 col-md-3">
            <div style="position: relative; overflow: hidden; border-radius: 10px; aspect-ratio: 1;">
              <img src="/uploads/galeri/${g.filename}" 
                   alt="${g.judul}" 
                   style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s;"
                   onmouseover="this.style.transform='scale(1.05)'"
                   onmouseout="this.style.transform='scale(1)'">
            </div>
          </div>
        `;
                    });
                    container.innerHTML = html;
                } catch (error) {
                    document.getElementById('galeriBeranda').innerHTML =
                        '<div class="col-12 text-center text-muted">Gagal memuat galeri.</div>';
                }
            })();
        </script>

        <!-- Section Ajakan Donasi -->
        <section class="py-5 bg-success text-white position-relative overflow-hidden">
            <!-- Dekorasi Background (Opsional, agar tidak polos) -->
            <div
                style="position: absolute; top: -50px; right: -50px; width: 200px; height: 200px; background: rgba(255,255,255,0.1); border-radius: 50%;">
            </div>
            <div
                style="position: absolute; bottom: -30px; left: -30px; width: 150px; height: 150px; background: rgba(255,255,255,0.1); border-radius: 50%;">
            </div>

            <div class="container position-relative">
                <div class="row align-items-center">
                    <div class="col-lg-7 mb-4 mb-lg-0">
                        <h2 class="display-6 fw-bold mb-3">
                            <i class="bi bi-heart-fill text-warning"></i> Salurkan Infaq & Sedekah Terbaik Anda
                        </h2>
                        <p class="lead mb-4">
                            Bantu kami memakmurkan masjid, menunjang kegiatan kajian, dan membantu sesama melalui
                            masjid.
                            Setiap rupiah yang Anda berikan akan dicatat dan dipertanggungjawabkan secara transparan.
                        </p>

                        <!-- Info Rekening Singkat -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div class="bg-white bg-opacity-10 rounded p-3 border border-white border-opacity-25">
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-bank fs-3 me-3 text-warning"></i>
                                        <div>
                                            <small class="d-block opacity-75">Bank Syariah Indonesia (BSI)</small>
                                            <strong class="fs-5">123-456-7890</strong>
                                            <small class="d-block opacity-75">a.n. DKM Masjid Al-Ikhlas</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="bg-white bg-opacity-10 rounded p-3 border border-white border-opacity-25">
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-bank fs-3 me-3 text-warning"></i>
                                        <div>
                                            <small class="d-block opacity-75">Bank Mandiri</small>
                                            <strong class="fs-5">098-765-4321</strong>
                                            <small class="d-block opacity-75">a.n. DKM Masjid Al-Ikhlas</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <a href="/kontak#donasi" class="btn btn-warning btn-lg fw-bold text-dark shadow-sm">
                            <i class="bi bi-send-fill"></i> Konfirmasi Donasi Saya
                        </a>
                    </div>

                    <div class="col-lg-5 text-center">
                        <div class="bg-white text-dark rounded-4 p-4 shadow-lg">
                            <h4 class="fw-bold mb-3">Mengapa Berdonasi di Sini?</h4>
                            <ul class="list-unstyled text-start">
                                <li class="mb-3 d-flex align-items-start">
                                    <i class="bi bi-check-circle-fill text-success me-2 mt-1"></i>
                                    <span><strong>100% Transparan:</strong> Laporan keuangan bisa diakses publik kapan
                                        saja.</span>
                                </li>
                                <li class="mb-3 d-flex align-items-start">
                                    <i class="bi bi-check-circle-fill text-success me-2 mt-1"></i>
                                    <span><strong>Tersalurkan Tepat:</strong> Langsung untuk operasional dan kegiatan
                                        masjid.</span>
                                </li>
                                <li class="d-flex align-items-start">
                                    <i class="bi bi-check-circle-fill text-success me-2 mt-1"></i>
                                    <span><strong>Mudah & Cepat:</strong> Cukup transfer dan konfirmasi melalui form
                                        online.</span>
                                </li>
                            </ul>
                            <a href="/keuangan" class="btn btn-outline-success w-100 mt-2">
                                <i class="bi bi-graph-up"></i> Lihat Laporan Keuangan
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Lokasi & Kontak -->
        <section class="py-5 bg-light">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-md-6 mb-4 mb-md-0">
                        <h2 class="fw-bold mb-4">📍 Lokasi Kami</h2>
                        <p class="lead">Jl. Merdeka No. 123, Kelurahan Sukamaju, Kecamatan Bahagia, Kota Sejahtera.</p>
                        <ul class="list-unstyled">
                            <li class="mb-2"><i class="bi bi-telephone-fill text-success me-2"></i> (021) 1234-5678</li>
                            <li class="mb-2"><i class="bi bi-whatsapp text-success me-2"></i> 0812-3456-7890
                                (Sekretariat)</li>
                            <li class="mb-2"><i class="bi bi-envelope-fill text-success me-2"></i>
                                info@masjid-alikhlas.com</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <div class="ratio ratio-16x9 shadow-sm">
                            <!-- Ganti src iframe di bawah dengan embed Google Maps masjid Anda -->
                            <iframe
                                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3966.521260322283!2d106.8195613507536!3d-6.194741395493371!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e69f5390917b759%3A0x6b45e67356080477!2sMonumen%20Nasional!5e0!3m2!1sid!2sid!4v1620000000000!5m2!1sid!2sid"
                                style="border:0; border-radius: 10px;" allowfullscreen="" loading="lazy">
                            </iframe>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <!-- Back to Top Button -->
        <button onclick="window.scrollTo({top: 0, behavior: 'smooth'})" id="backToTop"
            class="btn btn-success btn-lg rounded-circle shadow-lg"
            style="position: fixed; bottom: 30px; right: 30px; display: none; z-index: 1000; width: 50px; height: 50px;">
            <i class="bi bi-arrow-up"></i>
        </button>

        <script>
            // Tampilkan tombol back to top saat scroll
            window.addEventListener('scroll', function () {
                const backToTop = document.getElementById('backToTop');
                if (window.pageYOffset > 300) {
                    backToTop.style.display = 'block';
                } else {
                    backToTop.style.display = 'none';
                }
            });
        </script>

        <% include('../partials/footer') %>