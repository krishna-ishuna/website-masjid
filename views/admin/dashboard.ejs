<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Admin - Masjid</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

    <!-- Navbar -->
    <nav class="navbar navbar-dark bg-primary mb-4">
        <div class="container">
            <span class="navbar-brand mb-0 h1">🕌 Panel Admin Masjid</span>
            <div class="d-flex align-items-center text-white">
                <span class="me-3">Halo, <%= user.username %> (<%= user.role %>)</span>
                <form action="/admin/logout" method="POST">
                    <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                </form>
            </div>
        </div>
    </nav>

    <!-- Konten Dashboard -->
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="card shadow-sm">
                    <!-- Tambahkan di atas card "Selamat Datang" -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <a href="/admin/kontak" class="card text-decoration-none border-0 shadow-sm h-100">
                                <div class="card-body d-flex align-items-center">
                                    <i class="bi bi-chat-dots-fill text-primary" style="font-size: 2.5rem;"></i>
                                    <div class="ms-3">
                                        <h5 class="mb-0 text-dark">Pesan Kontak</h5>
                                        <small class="text-muted">Lihat pesan dari jamaah</small>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-6">
                            <a href="/admin/donasi" class="card text-decoration-none border-0 shadow-sm h-100">
                                <div class="card-body d-flex align-items-center">
                                    <i class="bi bi-heart-fill text-danger" style="font-size: 2.5rem;"></i>
                                    <div class="ms-3">
                                        <h5 class="mb-0 text-dark">Pengajuan Donasi</h5>
                                        <small class="text-muted">Verifikasi donasi masuk</small>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                    <!-- Ganti bagian card-body dengan ini -->
                    <div class="card-body">
                        <h4 class="card-title">Selamat Datang di Dashboard!</h4>
                        <p class="card-text">Pilih menu dibawah untuk mengelola website:</p>

                        <div class="row mt-4">
                            <div class="col-md-4 mb-3">
                                <a href="/admin/pengumuman" class="btn btn-primary w-100">📢 Kelola Pengumuman</a>
                            </div>
                            <div class="col-md-4 mb-3">
                                <a href="/admin/keuangan" class="btn btn-secondary w-100">💰 Kelola Keuangan</a>
                            </div>
                            <div class="col-md-4 mb-3">
                                <a href="/jadwal" class="btn btn-info text-white w-100">🕐 Lihat Jadwal Sholat</a>
                            </div>
                            <div class="col-md-4 mb-3">
                                <a href="/admin/galeri" class="btn btn-info text-white w-100">🖼️ Kelola Galeri Foto</a>
                            </div>
                        </div>

                        <hr>
                        <a href="/" class="btn btn-success">Lihat Website Publik</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

</body>

</html>