<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Galeri Foto - Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>

<body>

    <nav class="navbar navbar-dark bg-primary mb-4">
        <div class="container">
            <span class="navbar-brand mb-0 h1">🕌 Panel Admin Masjid</span>
            <div class="d-flex align-items-center text-white">
                <span class="me-3">Halo, <%= user.username %></span>
                <form action="/admin/logout" method="POST">
                    <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <h2><i class="bi bi-images"></i> Galeri Foto</h2>
            <a href="/admin/galeri/tambah" class="btn btn-success">
                <i class="bi bi-upload"></i> Upload Foto
            </a>
        </div>

        <!-- Filter Kategori -->
        <div class="mb-4">
            <div class="btn-group flex-wrap" role="group">
                <a href="/admin/galeri"
                    class="btn btn-outline-primary <%= kategoriAktif === 'semua' ? 'active' : '' %>">Semua</a>
                <a href="/admin/galeri?kategori=kajian"
                    class="btn btn-outline-primary <%= kategoriAktif === 'kajian' ? 'active' : '' %>">Kajian</a>
                <a href="/admin/galeri?kategori=kegiatan"
                    class="btn btn-outline-primary <%= kategoriAktif === 'kegiatan' ? 'active' : '' %>">Kegiatan</a>
                <a href="/admin/galeri?kategori=pembangunan"
                    class="btn btn-outline-primary <%= kategoriAktif === 'pembangunan' ? 'active' : '' %>">Pembangunan</a>
                <a href="/admin/galeri?kategori=sosial"
                    class="btn btn-outline-primary <%= kategoriAktif === 'sosial' ? 'active' : '' %>">Sosial</a>
                <a href="/admin/galeri?kategori=ramadhan"
                    class="btn btn-outline-primary <%= kategoriAktif === 'ramadhan' ? 'active' : '' %>">Ramadhan</a>
            </div>
        </div>

        <% if (galeri.length===0) { %>
            <div class="alert alert-info text-center">
                <i class="bi bi-info-circle"></i> Belum ada foto.
                <a href="/admin/galeri/tambah">Upload yang pertama!</a>
            </div>
            <% } else { %>
                <div class="row g-3">
                    <% galeri.forEach(g=> { %>
                        <div class="col-6 col-md-4 col-lg-3">
                            <div class="card h-100 shadow-sm">
                                <img src="/uploads/galeri/<%= g.filename %>" class="card-img-top" alt="<%= g.judul %>"
                                    style="height: 180px; object-fit: cover;">
                                <div class="card-body p-2">
                                    <h6 class="card-title mb-1" style="font-size: 0.9rem;">
                                        <%= g.judul %>
                                    </h6>
                                    <span class="badge bg-info mb-2">
                                        <%= g.kategori %>
                                    </span>
                                    <div class="d-flex gap-1">
                                        <a href="/admin/galeri/edit/<%= g._id %>"
                                            class="btn btn-sm btn-warning flex-grow-1">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form action="/admin/galeri/hapus/<%= g._id %>" method="POST"
                                            class="flex-grow-1" onsubmit="return confirm('Yakin hapus foto ini?')">
                                            <button type="submit" class="btn btn-sm btn-danger w-100">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                </div>
                <% } %>

                    <a href="/admin/dashboard" class="btn btn-secondary mt-4">← Kembali ke Dashboard</a>
    </div>

</body>

</html>