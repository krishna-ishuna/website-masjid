<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= action %> Foto - Admin
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        .upload-area {
            border: 2px dashed #198754;
            border-radius: 10px;
            padding: 40px;
            text-align: center;
            background: #f8f9fa;
            cursor: pointer;
            transition: all 0.3s;
        }

        .upload-area:hover {
            background: #e9f7ef;
        }

        .preview-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 10px;
            margin-top: 20px;
        }

        .preview-item {
            position: relative;
            aspect-ratio: 1;
            overflow: hidden;
            border-radius: 8px;
        }

        .preview-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
    </style>
</head>

<body>

    <nav class="navbar navbar-dark bg-primary mb-4">
        <div class="container">
            <span class="navbar-brand mb-0 h1">🕌 Panel Admin Masjid</span>
            <div class="d-flex align-items-center text-white">
                <span class="me-3">Halo, <%= user.username %></span>
                <form action="/admin/logout" method="POST">
                    <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container">
        <h2 class="mb-4">
            <%= action %> Foto
        </h2>

        <% if (galeri) { %>
            <!-- MODE EDIT: Hanya edit info, tidak ganti file -->
            <form action="/admin/galeri/<%= galeri._id %>" method="POST">
                <div class="mb-3">
                    <label class="form-label">Foto Saat Ini</label>
                    <div>
                        <img src="/uploads/galeri/<%= galeri.filename %>" class="img-thumbnail"
                            style="max-width: 300px;">
                    </div>
                </div>

                <div class="mb-3">
                    <label for="judul" class="form-label">Judul Foto</label>
                    <input type="text" class="form-control" id="judul" name="judul" value="<%= galeri.judul %>"
                        required>
                </div>

                <div class="mb-3">
                    <label for="kategori" class="form-label">Kategori</label>
                    <select class="form-select" id="kategori" name="kategori" required>
                        <option value="kajian" <%=galeri.kategori==='kajian' ? 'selected' : '' %>>Kajian</option>
                        <option value="kegiatan" <%=galeri.kategori==='kegiatan' ? 'selected' : '' %>>Kegiatan</option>
                        <option value="pembangunan" <%=galeri.kategori==='pembangunan' ? 'selected' : '' %>>Pembangunan
                        </option>
                        <option value="sosial" <%=galeri.kategori==='sosial' ? 'selected' : '' %>>Sosial</option>
                        <option value="ramadhan" <%=galeri.kategori==='ramadhan' ? 'selected' : '' %>>Ramadhan</option>
                        <option value="lainnya" <%=galeri.kategori==='lainnya' ? 'selected' : '' %>>Lainnya</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label for="deskripsi" class="form-label">Deskripsi (Opsional)</label>
                    <textarea class="form-control" id="deskripsi" name="deskripsi"
                        rows="3"><%= galeri.deskripsi %></textarea>
                </div>

                <button type="submit" class="btn btn-primary">💾 Simpan</button>
                <a href="/admin/galeri" class="btn btn-secondary">Batal</a>
            </form>

            <% } else { %>
                <!-- MODE UPLOAD: Upload multiple foto -->
                <form action="/admin/galeri" method="POST" enctype="multipart/form-data" id="formUpload">
                    <div class="mb-3">
                        <label for="judul" class="form-label">Judul Album / Kegiatan</label>
                        <input type="text" class="form-control" id="judul" name="judul"
                            placeholder="Contoh: Kajian Subuh 12 Juli 2026" required>
                    </div>

                    <div class="mb-3">
                        <label for="kategori" class="form-label">Kategori</label>
                        <select class="form-select" id="kategori" name="kategori" required>
                            <option value="kajian">Kajian</option>
                            <option value="kegiatan">Kegiatan</option>
                            <option value="pembangunan">Pembangunan</option>
                            <option value="sosial">Sosial</option>
                            <option value="ramadhan">Ramadhan</option>
                            <option value="lainnya">Lainnya</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="deskripsi" class="form-label">Deskripsi (Opsional)</label>
                        <textarea class="form-control" id="deskripsi" name="deskripsi" rows="3"
                            placeholder="Ceritakan sedikit tentang kegiatan ini..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            <i class="bi bi-images"></i> Pilih Foto (Bisa Lebih dari 1)
                        </label>
                        <div class="upload-area" id="uploadArea">
                            <i class="bi bi-cloud-upload" style="font-size: 3rem; color: #198754;"></i>
                            <h5 class="mt-2">Klik untuk Pilih Foto</h5>
                            <p class="text-muted mb-0">atau drag & drop file di sini</p>
                            <small class="text-muted">Format: JPG, PNG, WEBP. Maksimal 3MB per file. Max 20
                                foto.</small>
                        </div>

                        <!-- PENTING: name="fotos[]" dengan kurung siku, multiple WAJIB -->
                        <input type="file" id="fotos" name="fotos[]" accept="image/*" multiple style="display: none;">

                        <p class="mt-2 text-success" id="jumlahFoto" style="display: none;">
                            <i class="bi bi-check-circle"></i> <span>0</span> foto dipilih
                        </p>
                    </div>

                    <!-- Preview foto yang dipilih -->
                    <div id="previewContainer" class="preview-grid" style="display: none;"></div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="bi bi-upload"></i> Upload Semua Foto
                        </button>
                        <a href="/admin/galeri" class="btn btn-secondary btn-lg">Batal</a>
                    </div>
                </form>
                <% } %>
    </div>

    <script>
        const inputFoto = document.getElementById('fotos');
        const uploadArea = document.getElementById('uploadArea');
        const previewContainer = document.getElementById('previewContainer');
        const jumlahFotoEl = document.getElementById('jumlahFoto');

        // Klik area upload untuk buka file dialog
        uploadArea.addEventListener('click', () => {
            inputFoto.click();
        });

        // Event saat file dipilih
        inputFoto.addEventListener('change', function (e) {
            const files = Array.from(e.target.files);
            previewContainer.innerHTML = '';

            if (files.length === 0) {
                previewContainer.style.display = 'none';
                jumlahFotoEl.style.display = 'none';
                return;
            }

            // Validasi & hitung file valid
            const validFiles = files.filter(file => {
                if (file.size > 3 * 1024 * 1024) {
                    alert(`File "${file.name}" terlalu besar! Maksimal 3MB.`);
                    return false;
                }
                if (!file.type.startsWith('image/')) {
                    alert(`File "${file.name}" bukan gambar!`);
                    return false;
                }
                return true;
            });

            if (validFiles.length === 0) {
                inputFoto.value = ''; // Reset input
                previewContainer.style.display = 'none';
                jumlahFotoEl.style.display = 'none';
                return;
            }

            // Tampilkan jumlah foto
            jumlahFotoEl.style.display = 'block';
            jumlahFotoEl.querySelector('span').textContent = validFiles.length;

            // Buat preview untuk setiap foto
            validFiles.forEach((file, index) => {
                const reader = new FileReader();
                reader.onload = function (event) {
                    const div = document.createElement('div');
                    div.className = 'preview-item';
                    div.innerHTML = `
          <img src="${event.target.result}" alt="Preview ${index + 1}">
          <div style="position: absolute; bottom: 5px; right: 5px; background: rgba(0,0,0,0.7); color: white; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem;">
            ${index + 1}/${validFiles.length}
          </div>
        `;
                    previewContainer.appendChild(div);
                };
                reader.readAsDataURL(file);
            });

            previewContainer.style.display = 'grid';
        });

        // Drag & Drop
        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            uploadArea.addEventListener(eventName, (e) => {
                e.preventDefault();
                e.stopPropagation();
            });
        });

        ['dragenter', 'dragover'].forEach(eventName => {
            uploadArea.addEventListener(eventName, () => {
                uploadArea.style.background = '#d4edda';
                uploadArea.style.borderColor = '#0d6832';
            });
        });

        ['dragleave', 'drop'].forEach(eventName => {
            uploadArea.addEventListener(eventName, () => {
                uploadArea.style.background = '#f8f9fa';
                uploadArea.style.borderColor = '#198754';
            });
        });

        uploadArea.addEventListener('drop', (e) => {
            const dt = new DataTransfer();
            Array.from(e.dataTransfer.files).forEach(file => dt.items.add(file));
            inputFoto.files = dt.files;
            inputFoto.dispatchEvent(new Event('change'));
        });
    </script>

</body>

</html>