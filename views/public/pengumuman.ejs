<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pengumuman - Masjid</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>

<body>

    <% include('../partials/navbar') %>

        <% const breadcrumbItems=[{ label: 'Pengumuman' }] %>
            <% include('../partials/breadcrumb') %>

                <div class="container py-5">
                    <h1 class="mb-4">📢 Pengumuman Terbaru</h1>

                    <% if (pengumuman.length===0) { %>
                        <div class="alert alert-info">Belum ada pengumuman saat ini.</div>
                        <% } else { %>
                            <!-- Ganti bagian forEach dengan ini: -->
                            <% pengumuman.forEach(p=> { %>
                                <div class="card mb-3 shadow-sm">
                                    <div class="card-body">
                                        <div class="row">
                                            <!-- Kolom Gambar (kiri) -->
                                            <div class="col-md-3">
                                                <% if (p.gambar) { %>
                                                    <img src="/uploads/<%= p.gambar %>" alt="<%= p.judul %>"
                                                        class="img-fluid rounded mb-2"
                                                        style="width: 100%; height: 150px; object-fit: cover;">
                                                    <% } else { %>
                                                        <div class="bg-light d-flex align-items-center justify-content-center"
                                                            style="width: 100%; height: 150px; border: 1px dashed #ccc;">
                                                            <i class="bi bi-image fs-1 text-muted"></i>
                                                        </div>
                                                        <% } %>
                                            </div>

                                            <!-- Kolom Konten (kanan) -->
                                            <div class="col-md-9">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <div>
                                                        <h5 class="card-title">
                                                            <%= p.judul %>
                                                        </h5>
                                                        <p class="card-text">
                                                            <%= p.isi %>
                                                        </p>
                                                    </div>
                                                    <span class="badge bg-info">
                                                        <%= p.kategori %>
                                                    </span>
                                                </div>
                                                <small class="text-muted">Diterbitkan: <%= new
                                                        Date(p.tanggal).toLocaleDateString('id-ID', { day: 'numeric' ,
                                                        month: 'long' , year: 'numeric' }) %></small>
                                            </div>
                                        </div>
                                        <% }) %>
                                            <% } %>
                                    </div>

                                    <!-- Back to Top Button -->
                                    <button onclick="window.scrollTo({top: 0, behavior: 'smooth'})" id="backToTop"
                                        class="btn btn-success btn-lg rounded-circle shadow-lg"
                                        style="position: fixed; bottom: 30px; right: 30px; display: none; z-index: 1000; width: 50px; height: 50px;">
                                        <i class="bi bi-arrow-up"></i>
                                    </button>

                                    <script>
                                        // Tampilkan tombol back to top saat scroll
                                        window.addEventListener('scroll', function () {
                                            const backToTop = document.getElementById('backToTop');
                                            if (window.pageYOffset > 300) {
                                                backToTop.style.display = 'block';
                                            } else {
                                                backToTop.style.display = 'none';
                                            }
                                        });
                                    </script>
                                    <section class="py-4">
                                        <div class="container">
                                            <a href="/" class="btn btn-outline-success">
                                                <i class="bi bi-arrow-left"></i> Kembali ke Beranda
                                            </a>
                                        </div>
                                    </section>

                                    <% include('../partials/footer') %>