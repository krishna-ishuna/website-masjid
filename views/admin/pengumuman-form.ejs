<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= action %> Pengumuman - Admin
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>

<body>

    <!-- Navbar -->
    <nav class="navbar navbar-dark bg-primary mb-4">
        <div class="container">
            <span class="navbar-brand mb-0 h1">🕌 Panel Admin Masjid</span>
            <div class="d-flex align-items-center text-white">
                <span class="me-3">Halo, <%= user.username %></span>
                <form action="/admin/logout" method="POST">
                    <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container">
        <h2 class="mb-4">
            <%= action %> Pengumuman
        </h2>

        <% if (typeof error !=='undefined' && error) { %>
            <div class="alert alert-danger">
                <%= error %>
            </div>
            <% } %>

                <!-- PENTING: enctype="multipart/form-data" WAJIB untuk upload file -->
                <form action="<%= pengumuman ? '/admin/pengumuman/' + pengumuman._id : '/admin/pengumuman' %>"
                    method="POST" enctype="multipart/form-data">

                    <div class="mb-3">
                        <label for="judul" class="form-label">Judul Pengumuman</label>
                        <input type="text" class="form-control" id="judul" name="judul"
                            value="<%= pengumuman ? pengumuman.judul : '' %>" required>
                    </div>

                    <div class="mb-3">
                        <label for="kategori" class="form-label">Kategori</label>
                        <select class="form-select" id="kategori" name="kategori" required>
                            <option value="pengumuman" <%=pengumuman && pengumuman.kategori==='pengumuman' ? 'selected'
                                : '' %>>Pengumuman Umum</option>
                            <option value="kajian" <%=pengumuman && pengumuman.kategori==='kajian' ? 'selected' : '' %>
                                >Kajian</option>
                            <option value="kegiatan" <%=pengumuman && pengumuman.kategori==='kegiatan' ? 'selected' : ''
                                %>>Kegiatan</option>
                            <option value="donasi" <%=pengumuman && pengumuman.kategori==='donasi' ? 'selected' : '' %>
                                >Donasi</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="isi" class="form-label">Isi Pengumuman</label>
                        <textarea class="form-control" id="isi" name="isi" rows="8"
                            required><%= pengumuman ? pengumuman.isi : '' %></textarea>
                    </div>

                    <!-- UPLOAD GAMBAR -->
                    <div class="mb-3">
                        <label for="gambar" class="form-label">
                            <i class="bi bi-image"></i> Gambar Pengumuman (Opsional)
                        </label>
                        <input type="file" class="form-control" id="gambar" name="gambar" accept="image/*">
                        <small class="text-muted">Format: JPG, PNG, WEBP, GIF. Maksimal 2MB.</small>

                        <!-- Preview gambar jika sedang edit dan ada gambar lama -->
                        <% if (pengumuman && pengumuman.gambar) { %>
                            <div class="mt-3">
                                <p class="mb-2"><strong>Gambar saat ini:</strong></p>
                                <img src="/uploads/<%= pengumuman.gambar %>" alt="Preview" class="img-thumbnail"
                                    style="max-width: 300px; max-height: 200px;">
                                <p class="text-muted small mt-2">
                                    <i class="bi bi-info-circle"></i> Upload gambar baru untuk mengganti gambar ini.
                                </p>
                            </div>
                            <% } %>
                    </div>

                    <!-- Preview gambar baru sebelum submit -->
                    <div id="previewContainer" class="mb-3" style="display: none;">
                        <p class="mb-2"><strong>Preview gambar baru:</strong></p>
                        <img id="previewImage" src="" alt="Preview" class="img-thumbnail"
                            style="max-width: 300px; max-height: 200px;">
                    </div>

                    <button type="submit" class="btn btn-primary">💾 Simpan</button>
                    <a href="/admin/pengumuman" class="btn btn-secondary">Batal</a>
                </form>
    </div>

    <script>
        // Preview gambar sebelum upload
        document.getElementById('gambar').addEventListener('change', function (e) {
            const file = e.target.files[0];
            const previewContainer = document.getElementById('previewContainer');
            const previewImage = document.getElementById('previewImage');

            if (file) {
                // Validasi ukuran di client-side
                if (file.size > 2 * 1024 * 1024) {
                    alert('Ukuran file terlalu besar! Maksimal 2MB.');
                    e.target.value = '';
                    previewContainer.style.display = 'none';
                    return;
                }

                const reader = new FileReader();
                reader.onload = function (event) {
                    previewImage.src = event.target.result;
                    previewContainer.style.display = 'block';
                };
                reader.readAsDataURL(file);
            } else {
                previewContainer.style.display = 'none';
            }
        });
    </script>

</body>

</html>