<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Laporan Keuangan - Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

    <!-- Navbar -->
    <nav class="navbar navbar-dark bg-primary mb-4">
        <div class="container">
            <span class="navbar-brand mb-0 h1">🕌 Panel Admin Masjid</span>
            <div class="d-flex align-items-center text-white">
                <span class="me-3">Halo, <%= user.username %></span>
                <form action="/admin/logout" method="POST">
                    <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>💰 Laporan Keuangan</h2>
            <a href="/admin/keuangan/tambah" class="btn btn-success">+ Tambah Transaksi</a>
        </div>

        <!-- Ringkasan Saldo -->
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card text-white bg-success">
                    <div class="card-body">
                        <h6 class="card-title">Total Pemasukan</h6>
                        <h3 class="mb-0">Rp <%= totalPemasukan.toLocaleString('id-ID') %>
                        </h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-white bg-danger">
                    <div class="card-body">
                        <h6 class="card-title">Total Pengeluaran</h6>
                        <h3 class="mb-0">Rp <%= totalPengeluaran.toLocaleString('id-ID') %>
                        </h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-white bg-info">
                    <div class="card-body">
                        <h6 class="card-title">Saldo Akhir</h6>
                        <h3 class="mb-0">Rp <%= saldo.toLocaleString('id-ID') %>
                        </h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabel Transaksi -->
        <% if (keuangan.length===0) { %>
            <div class="alert alert-info">Belum ada data keuangan. <a href="/admin/keuangan/tambah">Catat yang
                    pertama!</a></div>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Tanggal</th>
                                <th>Jenis</th>
                                <th>Kategori</th>
                                <th>Keterangan</th>
                                <th>Nominal</th>
                                <th>Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% keuangan.forEach(k=> { %>
                                <tr>
                                    <td>
                                        <%= new Date(k.tanggal).toLocaleDateString('id-ID') %>
                                    </td>
                                    <td>
                                        <% if (k.jenis==='pemasukan' ) { %>
                                            <span class="badge bg-success">Pemasukan</span>
                                            <% } else { %>
                                                <span class="badge bg-danger">Pengeluaran</span>
                                                <% } %>
                                    </td>
                                    <td><span class="badge bg-secondary">
                                            <%= k.kategori %>
                                        </span></td>
                                    <td>
                                        <%= k.keterangan %>
                                    </td>
                                    <td>
                                        <% if (k.jenis==='pemasukan' ) { %>
                                            <strong class="text-success">+ Rp <%= k.nominal.toLocaleString('id-ID') %>
                                                    </strong>
                                            <% } else { %>
                                                <strong class="text-danger">- Rp <%= k.nominal.toLocaleString('id-ID')
                                                        %></strong>
                                                <% } %>
                                    </td>
                                    <td>
                                        <a href="/admin/keuangan/edit/<%= k._id %>"
                                            class="btn btn-sm btn-warning">Edit</a>
                                        <form action="/admin/keuangan/hapus/<%= k._id %>" method="POST"
                                            style="display:inline;" onsubmit="return confirm('Yakin ingin menghapus?')">
                                            <button type="submit" class="btn btn-sm btn-danger">Hapus</button>
                                        </form>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
                <% } %>

                    <a href="/admin/dashboard" class="btn btn-secondary mt-3">← Kembali ke Dashboard</a>
    </div>

</body>

</html>