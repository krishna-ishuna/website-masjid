<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <title>Pengajuan Donasi - Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>

<body>

    <nav class="navbar navbar-dark bg-primary mb-4">
        <div class="container">
            <span class="navbar-brand mb-0 h1">🕌 Panel Admin Masjid</span>
            <div class="d-flex align-items-center text-white">
                <span class="me-3">Halo, <%= user.username %></span>
                <form action="/admin/logout" method="POST">
                    <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container">
        <h2 class="mb-4"><i class="bi bi-heart-fill"></i> Pengajuan Donasi</h2>

        <!-- Statistik -->
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card border-warning">
                    <div class="card-body">
                        <h6 class="text-muted">Menunggu Verifikasi</h6>
                        <h3 class="text-warning mb-0">
                            <%= menunggu %> pengajuan
                        </h3>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-success">
                    <div class="card-body">
                        <h6 class="text-muted">Total Donasi Terverifikasi</h6>
                        <h3 class="text-success mb-0">Rp <%= totalTerverifikasi.toLocaleString('id-ID') %>
                        </h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter -->
        <div class="mb-4">
            <div class="btn-group flex-wrap">
                <a href="/admin/donasi"
                    class="btn btn-outline-primary <%= statusAktif === 'semua' ? 'active' : '' %>">Semua</a>
                <a href="/admin/donasi?status=menunggu"
                    class="btn btn-outline-warning <%= statusAktif === 'menunggu' ? 'active' : '' %>">
                    ⏳ Menunggu
                </a>
                <a href="/admin/donasi?status=diverifikasi"
                    class="btn btn-outline-success <%= statusAktif === 'diverifikasi' ? 'active' : '' %>">
                    ✅ Terverifikasi
                </a>
                <a href="/admin/donasi?status=ditolak"
                    class="btn btn-outline-danger <%= statusAktif === 'ditolak' ? 'active' : '' %>">
                    ❌ Ditolak
                </a>
            </div>
        </div>

        <% if (donasi.length===0) { %>
            <div class="alert alert-info text-center">Tidak ada pengajuan donasi.</div>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Tanggal</th>
                                <th>Donatur</th>
                                <th>Nominal</th>
                                <th>Kategori</th>
                                <th>Status</th>
                                <th>Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% donasi.forEach(d=> { %>
                                <tr>
                                    <td>
                                        <%= new Date(d.createdAt).toLocaleDateString('id-ID') %>
                                    </td>
                                    <td>
                                        <strong>
                                            <%= d.namaDonatur %>
                                        </strong><br>
                                        <small class="text-muted">
                                            <%= d.telepon %>
                                        </small>
                                    </td>
                                    <td><strong>Rp <%= d.nominal.toLocaleString('id-ID') %></strong></td>
                                    <td><span class="badge bg-info">
                                            <%= d.kategori %>
                                        </span></td>
                                    <td>
                                        <% if (d.status==='menunggu' ) { %>
                                            <span class="badge bg-warning text-dark">⏳ Menunggu</span>
                                            <% } else if (d.status==='diverifikasi' ) { %>
                                                <span class="badge bg-success">✅ Verifikasi</span>
                                                <% } else { %>
                                                    <span class="badge bg-danger">❌ Ditolak</span>
                                                    <% } %>
                                    </td>
                                    <td>
                                        <a href="/admin/donasi/<%= d._id %>" class="btn btn-sm btn-primary">Detail</a>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
                <% } %>

                    <a href="/admin/dashboard" class="btn btn-secondary mt-3">← Kembali ke Dashboard</a>
    </div>

</body>

</html>