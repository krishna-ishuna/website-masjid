<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        .kontak-hero {
            background: linear-gradient(135deg, #0d6832 0%, #198754 100%);
            color: white;
            padding: 80px 0;
        }

        .nav-pills .nav-link.active {
            background-color: #198754 !important;
        }

        .info-card {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            border-radius: 15px;
            padding: 25px;
            height: 100%;
            border-left: 4px solid #198754;
        }

        .info-card i {
            font-size: 2rem;
            color: #198754;
        }

        .rekening-box {
            background: linear-gradient(135deg, #fff3cd 0%, #ffe69c 100%);
            border-radius: 15px;
            padding: 25px;
            border-left: 4px solid #ffc107;
        }
    </style>
</head>

<body>

    <% include('../partials/navbar') %>

        <% const breadcrumbItems=[{ label: 'Kontak & Donasi' }] %>
            <% include('../partials/breadcrumb') %>


                <!-- Hero -->
                <section class="kontak-hero text-center">
                    <div class="container">
                        <h1 class="display-5 fw-bold mb-3">
                            <i class="bi bi-envelope-heart"></i> Hubungi Kami
                        </h1>
                        <p class="lead mb-0">Sampaikan pesan, saran, atau pengajuan donasi Anda</p>
                    </div>
                </section>

                <!-- Alert Sukses -->
                <% if (success==='pesan' ) { %>
                    <div class="container mt-4">
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill"></i> <strong>Pesan berhasil dikirim!</strong>
                            Kami akan segera membalas pesan Anda.
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    </div>
                    <% } %>
                        <% if (success==='donasi' ) { %>
                            <div class="container mt-4">
                                <div class="alert alert-success alert-dismissible fade show" role="alert">
                                    <i class="bi bi-check-circle-fill"></i> <strong>Pengajuan donasi berhasil
                                        dikirim!</strong>
                                    Silakan transfer ke rekening yang tertera, lalu tunggu verifikasi dari bendahara
                                    kami.
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                </div>
                            </div>
                            <% } %>

                                <!-- Info Kontak -->
                                <section class="py-5 bg-light">
                                    <div class="container">
                                        <div class="row g-4">
                                            <div class="col-md-4">
                                                <div class="info-card">
                                                    <i class="bi bi-geo-alt-fill"></i>
                                                    <h5 class="mt-3">Alamat</h5>
                                                    <p class="text-muted mb-0">Jl. Merdeka No. 123, Kel. Sukamaju, Kec.
                                                        Bahagia,
                                                        Kota Sejahtera</p>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="info-card">
                                                    <i class="bi bi-telephone-fill"></i>
                                                    <h5 class="mt-3">Telepon / WA</h5>
                                                    <p class="text-muted mb-0">(021) 1234-5678<br>0812-3456-7890</p>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="info-card">
                                                    <i class="bi bi-envelope-fill"></i>
                                                    <h5 class="mt-3">Email</h5>
                                                    <p class="text-muted mb-0">info@masjid-alikhlas.com</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </section>

                                <!-- Form Tab -->
                                <section class="py-5">
                                    <div class="container">
                                        <div class="row">
                                            <div class="col-lg-8 mx-auto">
                                                <!-- Tab Navigation -->
                                                <ul class="nav nav-pills nav-justified mb-4" id="kontakTab"
                                                    role="tablist">
                                                    <li class="nav-item" role="presentation">
                                                        <button class="nav-link active" id="pesan-tab"
                                                            data-bs-toggle="pill" data-bs-target="#pesan" type="button">
                                                            <i class="bi bi-chat-dots"></i> Kirim Pesan
                                                        </button>
                                                    </li>
                                                    <li class="nav-item" role="presentation">
                                                        <button class="nav-link" id="donasi-tab" data-bs-toggle="pill"
                                                            data-bs-target="#donasi" type="button">
                                                            <i class="bi bi-heart-fill"></i> Ajukan Donasi
                                                        </button>
                                                    </li>
                                                </ul>

                                                <!-- Tab Content -->
                                                <div class="tab-content">

                                                    <!-- TAB 1: Kirim Pesan -->
                                                    <div class="tab-pane fade show active" id="pesan">
                                                        <div class="card shadow-sm border-0">
                                                            <div class="card-body p-4">
                                                                <h4 class="mb-4">📩 Kirim Pesan / Saran / Kritik</h4>
                                                                <form action="/kontak/pesan" method="POST">
                                                                    <div class="row">
                                                                        <div class="col-md-6 mb-3">
                                                                            <label class="form-label">Nama Lengkap <span
                                                                                    class="text-danger">*</span></label>
                                                                            <input type="text" class="form-control"
                                                                                name="nama" required>
                                                                        </div>
                                                                        <div class="col-md-6 mb-3">
                                                                            <label class="form-label">Email</label>
                                                                            <input type="email" class="form-control"
                                                                                name="email" placeholder="opsional">
                                                                        </div>
                                                                    </div>

                                                                    <div class="mb-3">
                                                                        <label class="form-label">No. Telepon /
                                                                            WhatsApp</label>
                                                                        <input type="tel" class="form-control"
                                                                            name="telepon" placeholder="08xxxxxxxxxx">
                                                                    </div>

                                                                    <div class="mb-3">
                                                                        <label class="form-label">Subjek <span
                                                                                class="text-danger">*</span></label>
                                                                        <input type="text" class="form-control"
                                                                            name="subjek"
                                                                            placeholder="Contoh: Saran untuk kegiatan masjid"
                                                                            required>
                                                                    </div>

                                                                    <div class="mb-3">
                                                                        <label class="form-label">Pesan <span
                                                                                class="text-danger">*</span></label>
                                                                        <textarea class="form-control" name="pesan"
                                                                            rows="5" required
                                                                            placeholder="Tulis pesan Anda di sini..."></textarea>
                                                                    </div>

                                                                    <button type="submit"
                                                                        class="btn btn-success btn-lg w-100">
                                                                        <i class="bi bi-send"></i> Kirim Pesan
                                                                    </button>
                                                                </form>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- TAB 2: Pengajuan Donasi -->
                                                    <div class="tab-pane fade" id="donasi">
                                                        <div class="card shadow-sm border-0">
                                                            <div class="card-body p-4">
                                                                <h4 class="mb-4">💝 Form Pengajuan Donasi</h4>

                                                                <!-- Info Rekening -->
                                                                <div class="rekening-box mb-4">
                                                                    <h5 class="mb-3"><i class="bi bi-bank"></i> Rekening
                                                                        Donasi
                                                                    </h5>
                                                                    <div class="row g-3">
                                                                        <div class="col-md-6">
                                                                            <strong>Bank Syariah Indonesia
                                                                                (BSI)</strong><br>
                                                                            No. Rek: <span
                                                                                class="text-danger fw-bold">123-456-7890</span><br>
                                                                            a.n. DKM Masjid Al-Ikhlas
                                                                        </div>
                                                                        <div class="col-md-6">
                                                                            <strong>Bank Mandiri</strong><br>
                                                                            No. Rek: <span
                                                                                class="text-danger fw-bold">098-765-4321</span><br>
                                                                            a.n. DKM Masjid Al-Ikhlas
                                                                        </div>
                                                                    </div>
                                                                    <hr>
                                                                    <small class="text-muted">
                                                                        <i class="bi bi-info-circle"></i> Setelah
                                                                        transfer,
                                                                        silakan isi form di bawah untuk konfirmasi.
                                                                    </small>
                                                                </div>

                                                                <form action="/kontak/donasi" method="POST">
                                                                    <div class="row">
                                                                        <div class="col-md-6 mb-3">
                                                                            <label class="form-label">Nama Donatur <span
                                                                                    class="text-danger">*</span></label>
                                                                            <input type="text" class="form-control"
                                                                                name="namaDonatur"
                                                                                placeholder="Boleh anonim" required>
                                                                        </div>
                                                                        <div class="col-md-6 mb-3">
                                                                            <label class="form-label">No. Telepon / WA
                                                                                <span
                                                                                    class="text-danger">*</span></label>
                                                                            <input type="tel" class="form-control"
                                                                                name="telepon"
                                                                                placeholder="08xxxxxxxxxx" required>
                                                                        </div>
                                                                    </div>

                                                                    <div class="mb-3">
                                                                        <label class="form-label">Email (untuk bukti
                                                                            donasi)</label>
                                                                        <input type="email" class="form-control"
                                                                            name="email" placeholder="opsional">
                                                                    </div>

                                                                    <div class="row">
                                                                        <div class="col-md-6 mb-3">
                                                                            <label class="form-label">Nominal (Rp) <span
                                                                                    class="text-danger">*</span></label>
                                                                            <input type="number" class="form-control"
                                                                                name="nominal" min="1000"
                                                                                placeholder="100000" required>
                                                                        </div>
                                                                        <div class="col-md-6 mb-3">
                                                                            <label class="form-label">Kategori Donasi
                                                                                <span
                                                                                    class="text-danger">*</span></label>
                                                                            <select class="form-select" name="kategori"
                                                                                required>
                                                                                <option value="infaq">Infaq Umum
                                                                                </option>
                                                                                <option value="zakat">Zakat</option>
                                                                                <option value="pembangunan">Pembangunan
                                                                                    Masjid
                                                                                </option>
                                                                                <option value="sosial">Bantuan Sosial
                                                                                </option>
                                                                                <option value="ramadhan">Ramadhan
                                                                                </option>
                                                                                <option value="lainnya">Lainnya</option>
                                                                            </select>
                                                                        </div>
                                                                    </div>

                                                                    <div class="mb-3">
                                                                        <label class="form-label">Metode
                                                                            Transfer</label>
                                                                        <select class="form-select" name="metode">
                                                                            <option value="transfer">Transfer Bank
                                                                            </option>
                                                                            <option value="qris">QRIS</option>
                                                                            <option value="tunai">Tunai (datang ke
                                                                                masjid)
                                                                            </option>
                                                                        </select>
                                                                    </div>

                                                                    <div class="mb-3">
                                                                        <label class="form-label">Keterangan
                                                                            (Opsional)</label>
                                                                        <textarea class="form-control" name="keterangan"
                                                                            rows="3"
                                                                            placeholder="Contoh: Sudah transfer ke BSI tanggal 14 Juli 2026"></textarea>
                                                                    </div>

                                                                    <div class="alert alert-info">
                                                                        <i class="bi bi-info-circle"></i>
                                                                        <strong>Catatan:</strong> Pengajuan Anda akan
                                                                        diverifikasi oleh bendahara kami.
                                                                        Kami akan menghubungi Anda via WhatsApp setelah
                                                                        donasi
                                                                        terkonfirmasi.
                                                                    </div>

                                                                    <button type="submit"
                                                                        class="btn btn-success btn-lg w-100">
                                                                        <i class="bi bi-heart-fill"></i> Kirim Pengajuan
                                                                        Donasi
                                                                    </button>
                                                                </form>
                                                            </div>
                                                        </div>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </section>
                                <!-- JavaScript untuk Auto-Open Tab Donasi dari URL Hash -->
                                <script>
                                    document.addEventListener('DOMContentLoaded', function () {
                                        // Cek apakah URL mengandung hash #donasi
                                        if (window.location.hash === '#donasi') {
                                            // Aktifkan tab donasi secara programatik
                                            const donasiTab = new bootstrap.Tab(document.querySelector('#donasi-tab'));
                                            donasiTab.show();

                                            // Smooth scroll ke form
                                            setTimeout(() => {
                                                document.querySelector('#donasi').scrollIntoView({
                                                    behavior: 'smooth',
                                                    block: 'start'
                                                });
                                            }, 300);
                                        }

                                        // Update URL hash saat user klik tab
                                        const tabs = document.querySelectorAll('[data-bs-toggle="pill"]');
                                        tabs.forEach(tab => {
                                            tab.addEventListener('shown.bs.tab', function (event) {
                                                const targetId = event.target.getAttribute('data-bs-target');
                                                history.replaceState(null, null, targetId);
                                            });
                                        });
                                    });
                                </script>

                                <!-- Back to Top Button -->
                                <button onclick="window.scrollTo({top: 0, behavior: 'smooth'})" id="backToTop"
                                    class="btn btn-success btn-lg rounded-circle shadow-lg"
                                    style="position: fixed; bottom: 30px; right: 30px; display: none; z-index: 1000; width: 50px; height: 50px;">
                                    <i class="bi bi-arrow-up"></i>
                                </button>

                                <script>
                                    // Tampilkan tombol back to top saat scroll
                                    window.addEventListener('scroll', function () {
                                        const backToTop = document.getElementById('backToTop');
                                        if (window.pageYOffset > 300) {
                                            backToTop.style.display = 'block';
                                        } else {
                                            backToTop.style.display = 'none';
                                        }
                                    });
                                </script>

                                <!-- Tombol Kembali -->
                                <section class="py-4">
                                    <div class="container">
                                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                            <a href="/" class="btn btn-outline-success">
                                                <i class="bi bi-arrow-left"></i> Kembali ke Beranda
                                            </a>
                                            <a href="/keuangan" class="btn btn-success">
                                                <i class="bi bi-wallet2"></i> Cek Laporan Keuangan
                                            </a>
                                        </div>
                                    </div>
                                </section>

                                <% include('../partials/footer') %>
                                    <!-- Bootstrap JS Bundle (termasuk Popper) -->
                                    <script
                                        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>